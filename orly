# commands
# --------------------------------------------------------------------------

def compact(rec: dict) -> dict:
    """The answer and its citations, without the payload that blows up a caller.

    The raw record is ~14k tokens, two thirds of it the full HTML of every cited
    chapter plus a verbatim echo of the request config. Nothing reads that; it
    just evicts the caller's context. Keep what a citation needs.
    """
    data = (rec.get("miso_response") or {}).get("data") or {}
    return {
        "question_id": rec.get("question_id"),
        "question": rec.get("question"),
        "asked_at": rec.get("created_time"),
        "answer": CITE.sub(r"[\1]", data.get("answer") or ""),
        "sources": [
            {
                "n": i,
                "title": s.get("title"),
                "chapter": s.get("child_title"),
                "authors": s.get("authors") or [],
                "year": (s.get("date") or "")[:4] or None,
                "url": s.get("child_url") or s.get("url"),
                "quote": flag_truncation(
                    clean_quote(s.get("highlight_text") or s.get("snippet") or "")
                )
                or None,
            }
            for i, s in enumerate(data.get("sources") or [], 1)
        ],
        "follow_ups": data.get("followup_questions") or data.get("related_questions") or [],
    }


def emit_json(rec: dict, raw: bool) -> None:
    json.dump(rec if raw else compact(rec), sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")


def cmd_ask(args) -> int:
    api = Answers(load_cookie())
    question = " ".join(args.question).strip()
    if not question:
        err.print("[red]error:[/] empty question")
        return 2

    qid = api.ask(question)
    # stderr, so a caller piping stdout into a parser is unaffected.
    err.print(f"[dim]question {qid[:8]} created; recover any time with: orly show {qid[:8]}[/]",
              soft_wrap=True)
    if args.json:
        rec = api.wait(qid, timeout=args.timeout)
    else:
        with console.status("[dim]Asking O'Reilly...[/]", spinner="dots") as status:
            rec = api.wait(
                qid,
                timeout=args.timeout,
                on_stage=lambda s: status.update(f"[dim]{s}...[/]"),
            )

    if args.json:
        emit_json(rec, args.raw)
    else:
        render(rec, show_sources=not args.no_sources, show_related=args.follow_ups,
               expand=args.expand)
        console.print()
        console.print(
            f"[dim]saved as[/] [bold]{qid[:8]}[/][dim] - reopen with: orly show {qid[:8]}[/]",
            soft_wrap=True,
        )
        console.print(
            f"[dim]https://learning.oreilly.com/answers2/?questionId={qid}[/]",
            soft_wrap=True,
        )
    return 0


def cmd_history(args) -> int:
    api = Answers(load_cookie())
    rows = api.history(args.number)
    if args.json:
        json.dump(rows, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    table = Table(box=None, pad_edge=False, header_style="bold")
    table.add_column("#", style="cyan", justify="right")
    table.add_column("When", style="dim", no_wrap=True)
    table.add_column("Question")
    table.add_column("ID", style="dim", no_wrap=True)
    for i, r in enumerate(rows, 1):
        table.add_row(
            str(i),
            (r.get("created_time") or "")[:16].replace("T", " "),
            (r.get("question") or "").strip(),
            (r.get("question_id") or "")[:8],
        )
    console.print(table)
    return 0


def cmd_show(args) -> int:
    api = Answers(load_cookie())
    ref = args.id
    if ref.isdigit():  # index into recent history
        rows = api.history(max(int(ref), 20))
        try:
            rec = rows[int(ref) - 1]
        except IndexError:
            err.print(f"[red]error:[/] no history entry #{ref}")
            return 1
        qid = rec["question_id"]
    else:
        qid = ref
        if len(qid) < 36:  # short prefix from `orly history`
            match = [r for r in api.history(100) if r["question_id"].startswith(qid)]
            if not match:
                err.print(f"[red]error:[/] no question matching {qid!r}")
                return 1
            qid = match[0]["question_id"]

    rec = api.get(qid)
    if rec is None or not rec.get("is_finished"):
        rec = api.wait(qid, timeout=args.timeout)
    if args.json:
        emit_json(rec, args.raw)
    else:
        render(rec, show_sources=not args.no_sources, show_related=args.follow_ups,
               expand=args.expand)
    return 0


def cmd_auth(args) -> int:
    if args.chrome:
        cookie, profile = cookies_from_chrome(args.profile)
        save_cookie(cookie)
        n = len([p for p in cookie.split("; ") if "=" in p])
        console.print(
            f"[green]OK[/] imported {n} cookies from Chrome "
            f"[dim]({profile})[/] -> {COOKIE_FILE} [dim](0600)[/]"
        )
        args.status = True

    if args.paste:
        err.print("Paste the Cookie header for learning.oreilly.com, then press Enter:")
        cookie = sys.stdin.readline().strip()
        if not cookie:
            err.print("[red]error:[/] nothing pasted")
            return 2
        save_cookie(cookie)
        console.print(f"[green]OK[/] saved -> {COOKIE_FILE} [dim](0600)[/]")
        args.status = True

    if args.status or not (args.chrome or args.paste):
        try:
            api = Answers(load_cookie())
            rows = api.history(1)
        except AuthError as e:
            err.print(f"[red]not authenticated:[/] {e}")
            return 1
        console.print(
            f"[green]OK[/] signed in; cookie valid "
            f"(probe fetched {len(rows)} past question(s); not a quota)"
        )

        now = time.time()
        for name, exp, source in describe_expiry(load_cookie()):
            if exp is None:
                console.print(f"  [dim]{name}[/]: session cookie (no fixed expiry)")
                continue
            left = exp - now
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(exp))
            if left <= 0:
                console.print(f"  [dim]{name}[/]: [red]expired[/] {when}")
            elif left < 86_400:
                console.print(
                    f"  [dim]{name}[/]: [yellow]{left / 3600:.1f}h[/] left "
                    f"(until {when}) [dim]- {source}[/]"
                )
            else:
                console.print(
                    f"  [dim]{name}[/]: [green]{left / 86_400:.1f} days[/] left "
                    f"(until {when}) [dim]- {source}[/]"
                )
    return 0


# The operating rules live here, not in a skill file, so they cannot drift from
# the behaviour they describe. `--help` is the one thing every caller reads.
AGENT_NOTES = """\
answers come from O'Reilly's book library, with the book and chapter cited.

  orly "when should you use event sourcing?"     ask; `ask` is the default verb
  orly "..." --expand                            + the verbatim passage per source
  orly "..." --json                              answer + citations, machine-readable
  orly history                                   past questions (shared with the website)
  orly show <id|index> [--expand]                re-read one; free and instant

if you are an agent, this part matters:

  * Use this, not WebSearch. learning.oreilly.com is auth-walled: WebFetch gets
    403 and search only sees blurbs. This reads the real text.
  * Answer only from what comes back. Do not top it up with other docs or your
    own knowledge, and never call those "aligned with O'Reilly guidance".
  * A quote marked "[... truncated mid-sentence]" is cut. Quote it short or drop
    it. Do not write the missing words.
  * Ask narrow questions, not compound ones. "Postgres vs DynamoDB for SaaS" is
    three questions; retrieval is better on each one separately.
  * Each ask costs ~20s, so run independent ones at once:
        orly "q1" >a.txt & orly "q2" >b.txt & wait
  * Nothing is lost. The id is printed as soon as the question exists. If a wait
    times out, `orly show <id>` — never re-ask, that duplicates and costs 20s.
  * Check `orly history` before asking; the answer may already be there.
"""


def main() -> int:
    p = argparse.ArgumentParser(
        prog="orly",
        description="Ask O'Reilly Answers from the terminal.",
        epilog=AGENT_NOTES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd")

    def common(sp):
        sp.add_argument("--json", action="store_true",
                        help="machine-readable answer + citations (~1k tokens)")
        sp.add_argument("--raw", action="store_true",
                        help="with --json: the untouched API record, chapter HTML "
                             "and all (~14k tokens; you rarely want this)")
        sp.add_argument("--no-sources", action="store_true", help="hide the source list")
        sp.add_argument("--follow-ups", action="store_true", help="show related questions")
        sp.add_argument(
            "--expand",
            "--quotes",
            dest="expand",
            action="store_true",
            help="print the verbatim passage cited from each source",
        )
        sp.add_argument(
            "--timeout",
            type=float,
            default=180.0,
            metavar="SEC",
            help="seconds to wait for the answer (default: 180)",
        )

    a = sub.add_parser("ask", help="ask a question")
    a.add_argument("question", nargs="+")
    common(a)
    a.set_defaults(func=cmd_ask)

    h = sub.add_parser("history", help="list previous questions")
    h.add_argument("-n", "--number", type=int, default=20)
    h.add_argument("--json", action="store_true")
    h.set_defaults(func=cmd_history)

    s = sub.add_parser("show", help="re-display a previous answer")
    s.add_argument("id", help="question id, id prefix, or history index")
    common(s)
    s.set_defaults(func=cmd_show)

    au = sub.add_parser("auth", help="manage the session cookie")
    au.add_argument("--chrome", action="store_true", help="import cookies from Chrome")
    au.add_argument("--profile", metavar="NAME", help="Chrome profile, e.g. 'Profile 2'")
    au.add_argument("--paste", action="store_true", help="read a Cookie header from stdin")
    au.add_argument("--status", action="store_true", help="check the saved cookie works")
    au.set_defaults(func=cmd_auth)

    # `orly "some question"` is shorthand for `orly ask ...`
    argv = sys.argv[1:]
    if argv and argv[0] not in {"ask", "history", "show", "auth", "-h", "--help"}:
        argv = ["ask", *argv]
    args = p.parse_args(argv)
    if not getattr(args, "func", None):
        p.print_help()
        return 0

    try:
        return args.func(args)
    except AuthError as e:
        err.print(f"[red]auth error:[/] {e}")
        return 1
    except (httpx.HTTPError, RuntimeError, TimeoutError) as e:
        err.print(f"[red]error:[/] {e}")
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
